# Database PostgreSQL yang dapat diakses oleh aplikasi dan Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth.js / NextAuth v5. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="ganti-dengan-random-secret-panjang"
AUTH_URL="http://localhost:3000"

# Admin awal untuk bootstrap satu kali setelah migrasi dan seed RBAC.
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_NIM=""
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# Variabel untuk skrip seed admin lama (scripts/seedAdmins.js); tidak dipakai
# oleh setup yang direkomendasikan dan skrip lama tidak sesuai schema saat ini.
ADMIN1_EMAIL=""
ADMIN1_PASS=""
ADMIN2_EMAIL=""
ADMIN2_PASS=""

# JWT helper lama; tidak digunakan oleh alur login Auth.js utama.
JWT_SECRET="ganti-jika-helper-jwt-lama-digunakan"

# Vercel Blob: gunakan token dari dua store berbeda.
# Private store untuk foto profil.
BLOB_READ_WRITE_TOKEN=""
# Public store untuk gambar galeri dan foto/preset team yang dikirim langsung via CDN.
BLOB_PUBLIC_READ_WRITE_TOKEN=""

# Opsional. Upstash Redis Pub/Sub untuk realtime lintas instance.
# Jika kosong, realtime memakai fallback in-memory lokal.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Push notification (opsional). Generate: bunx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Gunakan mailto:email atau URL origin aplikasi, mis. https://markasti.example
VAPID_SUBJECT="mailto:admin@example.com"

# Secret untuk endpoint dispatch notifikasi terjadwal; wajib jika fitur cron diaktifkan.
CRON_SECRET=""

# SMTP untuk verifikasi email dan pengingat jadwal (opsional; port umum 587 atau 465).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MarkasTI <noreply@example.com>"

# Variabel bawaan platform/build; tidak perlu disetel manual:
# NODE_ENV, VERCEL, VERCEL_ENV, VERCEL_URL
