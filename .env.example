DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
BLOB_READ_WRITE_TOKEN=""
# Separate public Vercel Blob store token for CDN-delivered gallery and team media.
BLOB_PUBLIC_READ_WRITE_TOKEN=""
# Optional Upstash Redis Pub/Sub for cross-instance SSE delivery.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
AUTH_SECRET="generate-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Generate with: bunx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="https://your-public-domain.example"

# Required by the scheduled notification endpoint in production.
CRON_SECRET=""

# Email pengingat jadwal.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
